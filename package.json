{
  "name": "obsidian-carve",
  "version": "0.1.0",
  "description": "Carve markup editor and reading view for Obsidian",
  "license": "MIT",
  "author": "Mark Scherer",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "npm run build:test && node --test",
    "build:test": "esbuild src/metadata.ts src/render.ts src/wysiwyg.ts src/visual-table.ts src/live-preview.ts --platform=node --format=esm --outdir=dist-test",
    "typecheck": "tsc --noEmit",
    "test:all": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "^1.2.3",
    "@markup-carve/carve": "github:markup-carve/carve-js#d58d12e74d6404eda01e85736da67ca8a6ed44bf",
    "codemirror": "^6.0.2",
    "smol-toml": "1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.6",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.0"
  }
}
